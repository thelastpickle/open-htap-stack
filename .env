
# Cassandra resources: minimal sizes sepcified here, see podman-compose.yml for defaults
#CASSANDRA_MAX_HEAP_SIZE=2G
#CASSANDRA_MEM_LIMIT=4g

# Host ports
ACCORD_SQL_PORT=9040

# Data Ingress
DEMO_TOPIC=demo-events
DEMO_EVENTS_PER_SEC=2000
DEMO_GROUP_ID=demo-cassandra-sink
DEMO_KEYSPACE=demo
DEMO_TABLE=events
DEMO_BATCH_SIZE=200

# Mission Control demo defaults.  N_ENTITIES is the starting fleet size, which
# the dashboard may change at runtime; MAX_ENTITIES is the ceiling it may not
# exceed, and fixes how much state the producer allocates up front.
DEMO_N_ENTITIES=100
DEMO_MAX_ENTITIES=2000
DEMO_OUTLIER_PERCENT=5.0

# Optional. Without a key the dashboard embeds text locally and translates
# natural-language questions with its own rules, so nothing here is required.
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
