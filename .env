
# Cassandra resources: minimal sizes sepcified here, see podman-compose.yml for defaults
#CASSANDRA_MAX_HEAP_SIZE=2G
#CASSANDRA_MEM_LIMIT=4g

# Host ports.  Only the host side of a published port belongs here.  5432 is
# accord-sql's Postgres wire protocol; move it if this machine already runs
# Postgres.  The container side is fixed in the service's own source.
ACCORD_SQL_PORT=5432
# The backend's REST API and its /docs.  Every in-network caller addresses
# backend:8000 by name, so moving this affects only what runs on the host: the
# URLs in the README, scripts/cqlite-memsample.sh, and `npm run dev`, which
# takes VITE_API_PROXY instead.
BACKEND_PORT=8000

# Data Ingress.  The rate is deliberately a trickle: turn it up on the dashboard's
# Settings page for the run being shown, and leave the file at 5 so a stack somebody
# forgets about does not fill their disk.  The docs' figures were measured at 2,000.
DEMO_TOPIC=demo-events
DEMO_EVENTS_PER_SEC=5
DEMO_GROUP_ID=demo-cassandra-sink
DEMO_KEYSPACE=demo
DEMO_TABLE=events
DEMO_BATCH_SIZE=200

# Mission Control demo defaults.  N_ENTITIES is the starting fleet size, which
# the dashboard may change at runtime; MAX_ENTITIES is the ceiling it may not
# exceed, and fixes how much state the producer allocates up front.
DEMO_N_ENTITIES=100
DEMO_MAX_ENTITIES=2000
DEMO_OUTLIER_PERCENT=5.0

# Optional. Without a key the dashboard embeds text locally and translates
# natural-language questions with its own rules, so nothing here is required.
#OPENAI_API_KEY=
#OPENROUTER_API_KEY=
