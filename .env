
# Cassandra resources: minimal sizes sepcified here, see podman-compose.yml for defaults
#CASSANDRA_MAX_HEAP_SIZE=2G
#CASSANDRA_MEM_LIMIT=4g

# Host ports
JEFF_SQL_PORT=9040

# Data Ingress
DEMO_TOPIC=demo-events
DEMO_EVENTS_PER_SEC=5000
DEMO_PAYLOAD_BYTES=256
DEMO_GROUP_ID=demo-cassandra-sink
DEMO_KEYSPACE=demo
DEMO_TABLE=events
DEMO_BATCH_SIZE=200
DEMO_LOG_EVERY=10000
