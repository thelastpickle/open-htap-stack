cassandra-data/*

# The Ivy cache's jars and ivy.xml files are committed on purpose, so a build
# resolves offline; only the resolver's own scratch files are ignored.
spark/ivy/cache/**/*.xml.original
spark/ivy/cache/**/ivydata-*.properties
spark/ivy/jars

# Dashboard build output and dependencies.  package-lock.json is committed, so
# that an image built today and one built later install the same tree.
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Java.  Every module writes to its own target/, so the pattern is unanchored.
# The rule lands in the commit that adds the reactor, so every amend of an earlier
# commit is unprotected, and a `git add -A` in one committed nineteen build files
# three times: into the first commit, into the second after the first was rewritten,
# and into the third while this branch was being corrected against its reviews.
# .gitattributes routes *.jar through Git LFS, so the snapshot jar among them went in
# as an LFS pointer each time.  Amend an earlier commit with named paths, not -A.
target/

# The cqlite C library is committed gzipped and only gzipped, because Git LFS compresses
# nothing and 78 MB of it is the pair against 114 MB for one raw library.  The build script
# deletes the raw file after gzipping it; this is what stops a raw one that arrives another
# way from being staged, which is a 114 MB LFS object that cannot be taken back out.
htap-cqlite/dist/*.so

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Local compose override (see the file header)
podman-compose.local.yml

# Where a CI step's helpers land when the workflow is run by hand rather than
# on a runner, which has RUNNER_TEMP set (see the .claude/skills/ci-step skill)
.ci-tmp/

# What a service leaves in the repository root when it is run on the host
# rather than in its container
cassandra_debug.log
backend.log
settings-cache/

# Where roborev writes a diff too large for a review prompt, which is snapshot_dir
# in .roborev.toml.  Named in both places so the two cannot disagree.
/.roborev-snapshot/
