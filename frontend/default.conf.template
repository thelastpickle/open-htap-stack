# Rendered at container start by the nginx image's entrypoint, which substitutes
# NGINX_LOCAL_RESOLVERS with the container's own DNS servers.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The dashboard is a single-page app: any path that is not a real file has to
    # return index.html so the router can handle it.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The API is proxied so the browser sees one origin and needs no CORS, and the
    # frontend needs no backend address compiled into it.
    location /api/ {
        # nginx resolves a literal upstream name once, at start-up, and then holds
        # that address for ever — so restarting the backend would leave this
        # proxying to an address nothing answers on.  Naming the resolver and
        # passing the upstream through a variable defers the lookup to request
        # time, with the TTL below.
        resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
        # The address comes from the environment so that moving the dashboard from
        # one backend to another is a compose change rather than an image change.
        # It is a scheme, host and port and nothing else: with a variable in
        # proxy_pass, nginx passes the original request URI through only while the
        # variable holds no path, so a trailing slash or any path replaces the whole
        # request URI with it and every /api/... call arrives at the backend as
        # GET /, with 404s and nothing naming the cause.
        #
        # No default here, and an unset variable is a refusal rather than a silent
        # proxy to nowhere: envsubst leaves the placeholder in place, and nginx
        # reads it as one of its own and exits with
        # `[emerg] unknown "api_upstream" variable`.  compose declares it on the
        # frontend service.
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The four-path comparison of every event ever ingested takes minutes per
        # analytical path, and runs them in sequence by default, so one legitimate
        # request here can last the better part of an hour.  Generous on purpose:
        # giving up early is the worse failure, because the comparison carries on
        # in the backend and holds the lock that keeps runs one at a time, so the
        # browser reports a timeout and then has its retry refused with a 409.
        proxy_read_timeout 3600s;
    }
}
